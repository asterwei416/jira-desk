<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 來電紀錄系統</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f7f7fb; }
        .page-header { background: #ffffff; border-bottom: 1px solid #e5e7eb; }
        .card { border: 0; box-shadow: 0 6px 20px rgba(15, 23, 42, 0.08); }
        .table thead th { white-space: nowrap; }
        .sortable { cursor: pointer; }
        .sortable::after { content: ""; margin-left: 6px; border: 4px solid transparent; border-top-color: #94a3b8; display: inline-block; }
        .sortable.asc::after { border-top-color: transparent; border-bottom-color: #0f172a; }
        .sortable.desc::after { border-bottom-color: transparent; border-top-color: #0f172a; }
        .badge-status { font-size: 0.85rem; }
        .loading-mask { display: none; position: absolute; inset: 0; background: rgba(255,255,255,0.7); align-items: center; justify-content: center; z-index: 5; }
        @@media (min-width: 768px) {
            #searchCollapse.collapse { display: block; height: auto; visibility: visible; }
        }
    </style>
</head>
<body>
    <header class="page-header py-3 mb-4">
        <div class="container">
            <h1 class="h4 mb-0">客服來電問題紀錄與分析系統</h1>
        </div>
    </header>
    <main class="container pb-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
