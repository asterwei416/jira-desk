@{
    ViewData["Title"] = "詢問系統管理";
}

<div class="row">
    <div class="col-lg-5">
        <div class="card p-4 mb-4">
            <h2 class="h5 mb-3">新增詢問系統</h2>
            <div class="alert alert-danger d-none" id="createError"></div>
            <form id="createForm">
                <div class="mb-3">
                    <label class="form-label" for="name">系統名稱</label>
                    <input class="form-control" id="name" required maxlength="100" />
                </div>
                <button class="btn btn-primary w-100" type="submit">新增</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">系統清單</h2>
                <button class="btn btn-outline-secondary btn-sm" id="refreshBtn">重新整理</button>
            </div>
            <div class="alert alert-danger d-none" id="listError"></div>
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>名稱</th>
                        <th>狀態</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="systemTable"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() { return localStorage.getItem('accessToken'); }

        function renderRow(item) {
            const statusBadge = item.isActive
                ? '<span class="badge bg-success">啟用</span>'
                : '<span class="badge bg-secondary">停用</span>';

            const toggleLabel = item.isActive ? '停用' : '啟用';

            return `<tr>
                <td>${item.name}</td>
                <td>${statusBadge}</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" data-action="toggle" data-id="${item.id}" data-active="${item.isActive}">${toggleLabel}</button>
                    <button class="btn btn-sm btn-outline-danger" data-action="delete" data-id="${item.id}">刪除</button>
                </td>
            </tr>`;
        }

        function loadSystems() {
            const token = getToken();
            if (!token) {
                $('#listError').removeClass('d-none').text('請先登入管理者帳號');
                return;
            }

            fetch('/api/admin/inquiry-systems', {
                headers: { 'Authorization': `Bearer ${token}` }
            }).then(async response => {
                if (!response.ok) {
                    const result = await response.json();
                    throw new Error(result?.error || '載入失敗');
                }
                return response.json();
            }).then(items => {
                $('#systemTable').html(items.map(renderRow).join(''));
            }).catch(err => {
                $('#listError').removeClass('d-none').text(err.message);
            });
        }

        $(function () {
            loadSystems();

            $('#refreshBtn').on('click', loadSystems);

            $('#createForm').on('submit', function (e) {
                e.preventDefault();
                $('#createError').addClass('d-none').text('');

                const token = getToken();
                if (!token) {
                    $('#createError').removeClass('d-none').text('請先登入管理者帳號');
                    return;
                }

                fetch('/api/admin/inquiry-systems', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ name: $('#name').val() })
                }).then(async response => {
                    if (!response.ok) {
                        const result = await response.json();
                        throw new Error(result?.error || '新增失敗');
                    }
                    return response.json();
                }).then(() => {
                    $('#name').val('');
                    loadSystems();
                }).catch(err => {
                    $('#createError').removeClass('d-none').text(err.message);
                });
            });

            $('#systemTable').on('click', 'button[data-action]', function () {
                const action = $(this).data('action');
                const id = $(this).data('id');
                const token = getToken();

                if (!token) {
                    alert('請先登入管理者帳號');
                    return;
                }

                if (action === 'toggle') {
                    const currentActive = $(this).data('active') === true || $(this).data('active') === 'True';
                    fetch(`/api/admin/inquiry-systems/${id}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify({ name: $(this).closest('tr').find('td').first().text(), isActive: !currentActive })
                    }).then(loadSystems);
                }

                if (action === 'delete') {
                    fetch(`/api/admin/inquiry-systems/${id}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${token}` }
                    }).then(loadSystems);
                }
            });
        });
    </script>
}
