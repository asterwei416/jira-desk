@{
    ViewData["Title"] = "處理人員對應管理";
}

<div class="row">
    <div class="col-lg-5">
        <div class="card p-4 mb-4">
            <h2 class="h5 mb-3">新增對應</h2>
            <div class="alert alert-danger d-none" id="createError"></div>
            <form id="createForm">
                <div class="mb-3">
                    <label class="form-label" for="handlerId">處理人員 ID</label>
                    <input class="form-control" id="handlerId" type="number" min="1" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="systemId">詢問系統 ID</label>
                    <input class="form-control" id="systemId" type="number" min="1" required />
                </div>
                <button class="btn btn-primary w-100" type="submit">新增</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">對應清單</h2>
                <button class="btn btn-outline-secondary btn-sm" id="refreshBtn">重新整理</button>
            </div>
            <div class="alert alert-danger d-none" id="listError"></div>
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>處理人員</th>
                        <th>詢問系統</th>
                        <th>建立時間</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="mappingTable"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() { return localStorage.getItem('accessToken'); }

        function renderRow(item) {
            return `<tr>
                <td>${item.handler?.name || '-'}</td>
                <td>${item.inquirySystem?.name || '-'}</td>
                <td>${item.createdAt ? new Date(item.createdAt).toLocaleString() : '-'}</td>
                <td>
                    <button class="btn btn-sm btn-outline-danger" data-action="delete" data-id="${item.id}">刪除</button>
                </td>
            </tr>`;
        }

        function loadMappings() {
            const token = getToken();
            if (!token) {
                $('#listError').removeClass('d-none').text('請先登入管理者帳號');
                return;
            }

            fetch('/api/admin/handler-mappings', {
                headers: { 'Authorization': `Bearer ${token}` }
            }).then(async response => {
                if (!response.ok) {
                    const result = await response.json();
                    throw new Error(result?.error || '載入失敗');
                }
                return response.json();
            }).then(items => {
                $('#mappingTable').html(items.map(renderRow).join(''));
            }).catch(err => {
                $('#listError').removeClass('d-none').text(err.message);
            });
        }

        $(function () {
            loadMappings();
            $('#refreshBtn').on('click', loadMappings);

            $('#createForm').on('submit', function (e) {
                e.preventDefault();
                $('#createError').addClass('d-none').text('');

                const token = getToken();
                if (!token) {
                    $('#createError').removeClass('d-none').text('請先登入管理者帳號');
                    return;
                }

                fetch('/api/admin/handler-mappings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        handlerId: Number($('#handlerId').val()),
                        inquirySystemId: Number($('#systemId').val())
                    })
                }).then(async response => {
                    if (!response.ok) {
                        const result = await response.json();
                        throw new Error(result?.error || '新增失敗');
                    }
                    return response.json();
                }).then(() => {
                    $('#handlerId').val('');
                    $('#systemId').val('');
                    loadMappings();
                }).catch(err => {
                    $('#createError').removeClass('d-none').text(err.message);
                });
            });

            $('#mappingTable').on('click', 'button[data-action="delete"]', function () {
                const id = $(this).data('id');
                const token = getToken();
                if (!token) { alert('請先登入管理者帳號'); return; }

                fetch(`/api/admin/handler-mappings/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                }).then(loadMappings);
            });
        });
    </script>
}
