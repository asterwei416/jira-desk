@{
    ViewData["Title"] = "個人資料";
}

<div class="row">
    <div class="col-lg-6">
        <div class="card p-4 mb-4">
            <h2 class="h5 mb-3">個人資料</h2>
            <div class="alert alert-danger d-none" id="profileError"></div>
            <dl class="row mb-0" id="profileInfo">
                <dt class="col-sm-4">姓名</dt>
                <dd class="col-sm-8" data-field="name">-</dd>
                <dt class="col-sm-4">帳號</dt>
                <dd class="col-sm-8" data-field="username">-</dd>
                <dt class="col-sm-4">角色</dt>
                <dd class="col-sm-8" data-field="role">-</dd>
                <dt class="col-sm-4">LINE User ID</dt>
                <dd class="col-sm-8" data-field="lineUserId">-</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-4">
            <h2 class="h5 mb-3">變更密碼</h2>
            <div class="alert alert-danger d-none" id="passwordError"></div>
            <div class="alert alert-success d-none" id="passwordSuccess"></div>
            <form id="passwordForm">
                <div class="mb-3">
                    <label class="form-label" for="oldPassword">舊密碼</label>
                    <input class="form-control" id="oldPassword" type="password" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newPassword">新密碼</label>
                    <input class="form-control" id="newPassword" type="password" required />
                    <div class="form-text">至少 8 碼，需包含大小寫英文字母與數字。</div>
                </div>
                <button class="btn btn-primary w-100" type="submit">更新密碼</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() {
            return localStorage.getItem('accessToken');
        }

        function loadProfile() {
            const token = getToken();
            if (!token) {
                $('#profileError').removeClass('d-none').text('請先登入');
                return;
            }

            fetch('/api/auth/profile', {
                headers: { 'Authorization': `Bearer ${token}` }
            }).then(async response => {
                if (!response.ok) {
                    const result = await response.json();
                    throw new Error(result?.error || '取得個人資料失敗');
                }
                return response.json();
            }).then(profile => {
                $('#profileInfo [data-field="name"]').text(profile.name);
                $('#profileInfo [data-field="username"]').text(profile.username);
                $('#profileInfo [data-field="role"]').text(profile.role);
                $('#profileInfo [data-field="lineUserId"]').text(profile.lineUserId || '-');
            }).catch(err => {
                $('#profileError').removeClass('d-none').text(err.message);
            });
        }

        $(function () {
            loadProfile();

            $('#passwordForm').on('submit', function (e) {
                e.preventDefault();
                $('#passwordError').addClass('d-none').text('');
                $('#passwordSuccess').addClass('d-none').text('');

                const token = getToken();
                if (!token) {
                    $('#passwordError').removeClass('d-none').text('請先登入');
                    return;
                }

                const payload = {
                    oldPassword: $('#oldPassword').val(),
                    newPassword: $('#newPassword').val()
                };

                fetch('/api/auth/change-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                }).then(async response => {
                    if (!response.ok) {
                        const result = await response.json();
                        throw new Error(result?.error || '變更密碼失敗');
                    }
                    return response;
                }).then(() => {
                    $('#passwordSuccess').removeClass('d-none').text('密碼已更新');
                    $('#oldPassword').val('');
                    $('#newPassword').val('');
                }).catch(err => {
                    $('#passwordError').removeClass('d-none').text(err.message);
                });
            });
        });
    </script>
}
