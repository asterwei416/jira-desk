@{
    ViewData["Title"] = "編輯來電紀錄";
    var callRecordId = ViewData["CallRecordId"]?.ToString() ?? string.Empty;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h2 class="h5 mb-3">編輯來電紀錄</h2>
            <div class="alert alert-warning d-none" id="lockWarning"></div>
            <div class="alert alert-danger d-none" id="formError"></div>
            <form id="editForm">
                <div class="mb-3">
                    <label class="form-label" for="inquirySystem">詢問系統</label>
                    <input class="form-control" id="inquirySystem" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="subject">主旨</label>
                    <input class="form-control" id="subject" maxlength="50" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="content">內容</label>
                    <textarea class="form-control" id="content" maxlength="150" rows="4" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="urgency">緊急度</label>
                    <select class="form-select" id="urgency" required>
                        <option value="Low">低</option>
                        <option value="Medium">中</option>
                        <option value="High">高</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="contactName">聯絡人</label>
                        <input class="form-control" id="contactName" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="contactPhone">聯絡電話</label>
                        <input class="form-control" id="contactPhone" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="faqReference">參考 FAQ</label>
                    <input class="form-control" id="faqReference" maxlength="500" />
                </div>
                <button class="btn btn-primary w-100" type="submit">儲存</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const callRecordId = '@callRecordId';

        function setFormDisabled(disabled) {
            $('#editForm :input').prop('disabled', disabled);
        }

        function validatePhone(phone) {
            const regex = /^(0\d{1,2}-?\d{6,8}|09\d{2}-?\d{3}-?\d{3})$/;
            return regex.test(phone);
        }

        function loadRecord() {
            return fetch(`/api/CallRecords/${callRecordId}`)
                .then(response => response.json())
                .then(data => {
                    $('#inquirySystem').val(data.inquirySystem?.name || '-');
                    $('#subject').val(data.subject);
                    $('#content').val(data.content);
                    $('#urgency').val(data.urgencyLevel);
                    $('#contactName').val(data.contactName);
                    $('#contactPhone').val(data.contactPhone);
                    $('#faqReference').val(data.faqReference || '');
                });
        }

        function acquireLock() {
            return fetch(`/api/CallRecords/${callRecordId}/lock`, { method: 'POST' })
                .then(async response => {
                    if (response.status === 409) {
                        const result = await response.json();
                        throw new Error(result?.error || '此紀錄正在被編輯中');
                    }
                    if (!response.ok) {
                        const result = await response.json();
                        throw new Error(result?.error || '取得鎖定失敗');
                    }
                });
        }

        function releaseLock() {
            return fetch(`/api/CallRecords/${callRecordId}/lock`, { method: 'DELETE' });
        }

        $(function () {
            acquireLock()
                .then(loadRecord)
                .catch(err => {
                    $('#lockWarning').removeClass('d-none').text(err.message);
                    setFormDisabled(true);
                    return loadRecord();
                });

            $('#editForm').on('submit', function (e) {
                e.preventDefault();
                $('#formError').addClass('d-none').text('');

                const phone = $('#contactPhone').val();
                if (!validatePhone(phone)) {
                    $('#formError').removeClass('d-none').text('連絡電話格式錯誤');
                    return;
                }

                const payload = {
                    subject: $('#subject').val(),
                    content: $('#content').val(),
                    urgencyLevel: $('#urgency').val(),
                    contactName: $('#contactName').val(),
                    contactPhone: phone,
                    faqReference: $('#faqReference').val() || null
                };

                fetch(`/api/CallRecords/${callRecordId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                }).then(async response => {
                    if (!response.ok) {
                        const result = await response.json();
                        throw new Error(result?.error || '更新失敗');
                    }
                    return response.json();
                }).then(() => {
                    releaseLock();
                    window.location.href = `/CallRecord/Details/${callRecordId}`;
                }).catch(err => {
                    $('#formError').removeClass('d-none').text(err.message);
                });
            });

            window.addEventListener('beforeunload', function () {
                releaseLock();
            });
        });
    </script>
}
